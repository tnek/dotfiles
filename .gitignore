# Ignore everything under $HOME by default (yadm worktree)
*

# yadm metadata + dotfiles store (not littered at $HOME root)
!/.gitignore
!/README.md
!/.dotfiles/
/.dotfiles/*
!/.dotfiles/**
!/.config/yadm/
/.config/yadm/*
!/.config/yadm/bootstrap

# Dependencies installed by bootstrap (not versioned)
/.vim/plugged/
/.vim/autoload/plug.vim
/.dotfiles/.vim/plugged/
/.dotfiles/.vim/autoload/plug.vim
/.dotfiles/.vim/.netrwhist
/.zprezto/

# Local / machine-specific
.DS_Store
/.claude/
/dotfiles/

tags/
