" Shared Vim/Neovim config (Neovim loads this via ~/.config/nvim/init.lua)

" ----- General -----
set encoding=utf-8
set hidden
set number
set scrolloff=2
set signcolumn=yes
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set autoindent
set smartindent
set nohlsearch
set incsearch
set ignorecase
set smartcase
set nobackup
set noswapfile
set noerrorbells
set mouse=a
set laststatus=2

set clipboard=unnamed

" ----- Plugins -----
call plug#begin('~/.vim/plugged')

Plug 'rakr/vim-one'
Plug 'vim-airline/vim-airline'

if has('nvim')
  Plug 'neovim/nvim-lspconfig'
  Plug 'Saghen/blink.cmp', {'tag': 'v1.*'}
  Plug 'rafamadriz/friendly-snippets'
endif

Plug 'google/vim-maktaba'
Plug 'google/vim-codefmt'
Plug 'google/vim-glaive'

call plug#end()

if exists('*glaive#Install')
  call glaive#Install()
endif

" ----- Appearance -----
syntax enable
set background=light
colorscheme one
let g:airline_theme = 'one'

hi Normal guibg=NONE ctermbg=NONE
hi NonText guibg=NONE ctermbg=NONE
hi LineNr guibg=NONE ctermbg=NONE

" ----- Code formatting (vim-codefmt / glaive) -----
if exists(':Glaive')
  Glaive codefmt plugin[mappings]

  augroup autoformat_settings
    autocmd!
    autocmd FileType bzl AutoFormatBuffer buildifier
    autocmd FileType c,cpp,proto,javascript,arduino,objc AutoFormatBuffer clang-format
    autocmd FileType dart AutoFormatBuffer dartfmt
    " Go: gofmt on save — see .vim/ftplugin/go.vim
    autocmd FileType gn AutoFormatBuffer gn
    autocmd FileType html,css,sass,scss,less,json AutoFormatBuffer js-beautify
    autocmd FileType java AutoFormatBuffer google-java-format
    autocmd FileType python AutoFormatBuffer yapf
    autocmd FileType rust AutoFormatBuffer rustfmt
    autocmd FileType vue AutoFormatBuffer prettier
  augroup END
endif

" ----- Mappings -----
nnoremap <silent> <2-LeftMouse> <C-]>
