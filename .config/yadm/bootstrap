#!/usr/bin/env bash
# Runs automatically after `yadm clone` on macOS.
# Re-run manually: ~/.config/yadm/bootstrap

set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
    echo "Error: These dotfiles support macOS only." >&2
    exit 1
fi

echo "==> yadm bootstrap (macOS)"

DOTFILES_ROOT="$HOME/.dotfiles"

# Paths symlinked from ~/.dotfiles into $HOME (Brewfile/README stay in store only)
DOTFILE_LINKS=(
    .zshrc
    .zpreztorc
    .tmux.conf
    .screenrc
    .vim/vimrc
    .config/nvim/init.lua
    .config/nvim/lua/lsp.lua
    .config/nvim/lua/blink.lua
    .config/nvim/lua/run.lua
    .config/zsh/paths.zsh
    .config/zsh/post.zsh
)

link_into_home() {
    local rel="$1"
    local src="$DOTFILES_ROOT/$rel"
    local dest="$HOME/$rel"

    if [[ ! -e "$src" ]]; then
        echo "Error: missing $src" >&2
        return 1
    fi
    mkdir -p "$(dirname "$dest")"
    if [[ -e "$dest" && ! -L "$dest" ]]; then
        echo "==> Skipping $dest (exists and is not a symlink)" >&2
        return 0
    fi
    ln -sfn "$src" "$dest"
}

link_dotfiles() {
    if [[ ! -d "$DOTFILES_ROOT" ]]; then
        echo "Error: $DOTFILES_ROOT not found" >&2
        return 1
    fi
    echo "==> Linking dotfiles from $DOTFILES_ROOT"
    local rel
    for rel in "${DOTFILE_LINKS[@]}"; do
        link_into_home "$rel"
    done
}

link_dotfiles

setup_homebrew_path() {
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
}

run_optional() {
    local desc="$1"
    shift
    echo "==> $desc"
    if ! "$@"; then
        echo "==> WARNING: $desc failed" >&2
    fi
}

setup_homebrew_path

if ! command -v brew &>/dev/null; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    setup_homebrew_path
fi

BREWFILE="$DOTFILES_ROOT/Brewfile"
if [[ ! -f "$BREWFILE" ]]; then
    echo "Error: Brewfile not found at $BREWFILE" >&2
    exit 1
fi

echo "==> brew bundle install --file=$BREWFILE"
brew bundle install --file="$BREWFILE"

# PATH for remainder of this script (bash — do not source zsh paths.zsh)
setup_homebrew_path
for dir in \
    /opt/homebrew/opt/llvm/bin /usr/local/opt/llvm/bin \
    /opt/homebrew/opt/fzf/bin /usr/local/opt/fzf/bin \
    "$HOME/go/bin"
do
    [[ -d "$dir" ]] && export PATH="$dir:${PATH:-}"
done

install_terminal_theme() {
    local profile_path="$DOTFILES_ROOT/osx/atom-one-light.terminal"
    local plist="$HOME/Library/Preferences/com.apple.Terminal.plist"
    local hash_file="$HOME/.config/yadm/terminal-profile.sha256"

    if [[ ! -f "$profile_path" ]]; then
        echo "==> Skipping Terminal theme: $profile_path not found" >&2
        return 0
    fi

    local name current_hash stored_hash
    name=$(/usr/libexec/PlistBuddy -c 'Print :name' "$profile_path")
    current_hash=$(shasum -a 256 "$profile_path" | awk '{print $1}')
    stored_hash=""
    [[ -f "$hash_file" ]] && stored_hash=$(<"$hash_file")

    if [[ "$current_hash" == "$stored_hash" ]] \
        && /usr/libexec/PlistBuddy -c "Print ':Window Settings:${name}'" "$plist" &>/dev/null; then
        echo "==> Terminal profile $name unchanged"
        defaults write com.apple.Terminal "Default Window Settings" -string "$name"
        defaults write com.apple.Terminal "Startup Window Settings" -string "$name"
        return 0
    fi

    echo "==> Installing Terminal.app profile: $name"
    mkdir -p "$(dirname "$hash_file")"

    /usr/libexec/PlistBuddy -c 'Add :Window Settings dict' "$plist" 2>/dev/null || true
    if /usr/libexec/PlistBuddy -c "Print ':Window Settings:${name}'" "$plist" &>/dev/null; then
        /usr/libexec/PlistBuddy -c "Delete ':Window Settings:${name}'" "$plist"
    fi
    /usr/libexec/PlistBuddy -c "Add ':Window Settings:${name}' dict" "$plist"
    /usr/libexec/PlistBuddy -c "Merge '${profile_path}' ':Window Settings:${name}'" "$plist"

    defaults write com.apple.Terminal "Default Window Settings" -string "$name"
    defaults write com.apple.Terminal "Startup Window Settings" -string "$name"
    echo "$current_hash" >"$hash_file"

    echo "==> Terminal default profile: $name (open a new Terminal window to apply)"
}

run_optional "Terminal.app theme" install_terminal_theme

run_optional "zprezto" bash -c '
    if [[ ! -d "${ZDOTDIR:-$HOME}/.zprezto" ]]; then
        git clone --recursive https://github.com/sorin-ionescu/prezto.git "${ZDOTDIR:-$HOME}/.zprezto"
    else
        git -C "${ZDOTDIR:-$HOME}/.zprezto" pull --recurse-submodules
    fi
'

run_optional "vim-plug" bash -c '
    PLUG_PATH="$HOME/.vim/autoload/plug.vim"
    if [[ ! -f "$PLUG_PATH" ]]; then
        curl -fLo "$PLUG_PATH" --create-dirs \
            https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    fi
'

run_optional "nvim plugins" bash -c '
    if [[ -f "$HOME/.vim/vimrc" ]] && command -v nvim &>/dev/null; then
        nvim --headless "+PlugInstall --sync" +qa 2>/dev/null || nvim +PlugInstall +qall
    fi
'

run_optional "blink.cmp build" bash -c '
    if command -v nvim &>/dev/null; then
        nvim --headless "+BlinkCmp build" +qa 2>/dev/null \
            || nvim --headless "+lua require('\''blink.cmp.fuzzy.build'\'').build()" +qa 2>/dev/null \
            || true
    fi
'

echo "==> Done. Restart your shell."
echo "    Re-run bootstrap: ~/.config/yadm/bootstrap"
